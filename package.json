{
  "name": "family-app",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "api": "corepack pnpm --filter api start:dev",
    "api:inventory": "node scripts/api-inventory.mjs",
    "api:inventory:check": "node scripts/api-inventory.mjs --check",
    "events:check": "node scripts/check-event-routes.mjs",
    "plugins:check": "node scripts/check-plugins.mjs",
    "backup:dev": "sh scripts/backup-dev.sh",
    "backup:prod": "sh scripts/backup-prod.sh",
    "backup:worker:check": "sh -n scripts/backup-worker.sh && sh -n scripts/backup-worker-entrypoint.sh && sh -n scripts/restore-prod.sh && sh -n scripts/upgrade-prod.sh",
    "build:packages": "node scripts/build-packages.mjs",
    "demo": "corepack pnpm --filter api demo",
    "lint": "corepack pnpm --filter api lint && corepack pnpm --filter web lint && node scripts/check-secure-context.mjs",
    "lint:secure-context": "node scripts/check-secure-context.mjs",
    "lint:api": "corepack pnpm --filter api lint",
    "lint:web": "corepack pnpm --filter web lint",
    "postinstall": "node scripts/build-packages.mjs",
    "restore:dev": "sh scripts/restore-dev.sh",
    "restore:prod": "sh scripts/restore-prod.sh",
    "seed": "corepack pnpm --filter api seed",
    "test:api": "corepack pnpm --filter api test:api",
    "test:web": "corepack pnpm --filter api test:web",
    "typecheck": "node scripts/build-packages.mjs --check && corepack pnpm --filter api exec tsc --noEmit && corepack pnpm --filter web typecheck"
  }
}
