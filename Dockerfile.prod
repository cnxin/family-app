FROM node:22-alpine AS build

RUN npm install --global pnpm@10.34.5

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
# 工作区包和构建脚本先于 install 复制：根 postinstall 会执行 scripts/build-packages.mjs 构建 packages/*
COPY packages ./packages
COPY scripts/build-packages.mjs ./scripts/build-packages.mjs

RUN pnpm install --frozen-lockfile --filter api...

COPY apps/api ./apps/api

RUN pnpm --filter api build

FROM node:22-alpine AS production-dependencies

RUN npm install --global pnpm@10.34.5

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json

# --ignore-scripts：生产依赖阶段没有 typescript，不能跑 postinstall 构建；dist 从 build 阶段复制
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --filter api...

FROM node:22-alpine AS runtime

ENV NODE_ENV=production

WORKDIR /app/apps/api

COPY --chown=node:node --from=production-dependencies /app/node_modules /app/node_modules
COPY --chown=node:node --from=production-dependencies /app/apps/api/node_modules ./node_modules
COPY --chown=node:node --from=production-dependencies /app/apps/api/package.json ./package.json
# 工作区包在 node_modules 里是指向 /app/packages/* 的符号链接，所以要把构建产物放到同样的位置
COPY --chown=node:node --from=production-dependencies /app/packages/shared/package.json /app/packages/shared/package.json
COPY --chown=node:node --from=production-dependencies /app/packages/contracts/package.json /app/packages/contracts/package.json
COPY --chown=node:node --from=production-dependencies /app/packages/contracts/node_modules /app/packages/contracts/node_modules
COPY --chown=node:node --from=build /app/packages/shared/dist /app/packages/shared/dist
COPY --chown=node:node --from=build /app/packages/contracts/dist /app/packages/contracts/dist
COPY --chown=node:node --from=build /app/apps/api/dist ./dist

RUN mkdir -p uploads && chown node:node uploads

USER node

EXPOSE 3100

CMD ["node", "dist/main.js"]
