# C1 的 CI 补丁：镜像构建 job 现在只建 API 的两个镜像，Dockerfile.web 改成
# 「新客户端 + /legacy 旧客户端」之后没有任何一条流水线会去构建它。
# .github/workflows/ 受远程工具保护，这份 diff 由用户自己贴进 ci.yml。
# 和 docs/ci-pending-A2.diff 是两份独立补丁，谁先贴都行（改的不是同一段）。

--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -152,3 +152,8 @@
         run: docker build -f Dockerfile -t family-app-api:dev-ci .
       - name: 生产镜像能加载入口
         run: docker run --rm family-app-api:ci node -e "require('@family/shared'); require('@family/contracts'); console.log('workspace packages ok')"
+      - name: 构建前端镜像（新客户端 + /legacy）
+        run: docker build -f Dockerfile.web -t family-app-web:ci .
+      - name: 前端镜像的 Caddy 配置有效
+        run: docker run --rm -e SITE_ADDRESS=:80 family-app-web:ci caddy validate --config /etc/caddy/Caddyfile
+      - name: 两份静态产物都在
+        run: docker run --rm family-app-web:ci sh -c "test -f /srv/index.html && test -f /srv-legacy/index.html && echo 'web + legacy ok'"
