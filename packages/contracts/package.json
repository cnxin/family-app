{
  "name": "@family/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "小管家 HTTP 契约：每个端点的请求/响应 Zod schema 与路由注册表。API 用它校验，客户端用 z.infer 取类型。",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
