FROM node:22-alpine AS build

RUN npm install --global pnpm@10.34.5
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
# 工作区包和构建脚本先于 install 复制：根 postinstall 会执行 scripts/build-packages.mjs 构建 packages/*
# （和 Dockerfile.prod / Dockerfile.web 保持一致，漏掉这两行 install 阶段就会 MODULE_NOT_FOUND）
COPY packages ./packages
COPY scripts/build-packages.mjs ./scripts/build-packages.mjs
RUN pnpm install --frozen-lockfile --filter api...
COPY apps/api ./apps/api
RUN pnpm --filter api build

FROM node:22-alpine AS production-dependencies

RUN npm install --global pnpm@10.34.5
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
# --ignore-scripts：生产依赖阶段没有 typescript，不能跑 postinstall 构建；dist 从 build 阶段复制
RUN pnpm install --prod --frozen-lockfile --ignore-scripts --filter api...

FROM node:22-alpine

RUN apk add --no-cache postgresql16-client su-exec tzdata
WORKDIR /app
COPY --from=production-dependencies /app/node_modules /app/node_modules
COPY --from=production-dependencies /app/apps/api/node_modules /app/apps/api/node_modules
COPY --from=production-dependencies /app/apps/api/package.json /app/apps/api/package.json
COPY --from=production-dependencies /app/packages/shared/package.json /app/packages/shared/package.json
COPY --from=production-dependencies /app/packages/contracts/package.json /app/packages/contracts/package.json
COPY --from=build /app/packages/shared/dist /app/packages/shared/dist
COPY --from=build /app/packages/contracts/dist /app/packages/contracts/dist
COPY --from=build /app/apps/api/dist /app/apps/api/dist
COPY scripts/backup-worker-entrypoint.sh /usr/local/bin/backup-worker-entrypoint
COPY scripts/backup-worker.sh /usr/local/bin/backup-worker
RUN chmod 755 /usr/local/bin/backup-worker-entrypoint /usr/local/bin/backup-worker \
  && mkdir -p /backups /restore-work \
  && chown node:node /backups /restore-work

ENTRYPOINT ["/usr/local/bin/backup-worker-entrypoint"]
CMD ["/usr/local/bin/backup-worker"]
