# Media connectors are optional and can be enabled independently.
# Keep credentials in .env for local development only. Never commit .env.
MEDIA_PRIMARY_LIBRARY=plex

PLEX_BASE_URL=http://nas.example:32400
PLEX_TOKEN=
PLEX_NAME=Plex

EMBY_BASE_URL=
EMBY_API_KEY=
EMBY_NAME=Emby

MOVIEPILOT_BASE_URL=http://nas.example:3000
MOVIEPILOT_API_KEY=
MOVIEPILOT_NAME=MoviePilot

# Online media metadata. Bangumi works without a token; TMDB requires a token or key.
TMDB_API_TOKEN=
TMDB_API_KEY=

# Douban has no stable official public movie-search API. Point this at a private
# compatible bridge described in docs/m4-media-search-acceptance.md.
DOUBAN_API_BASE_URL=
DOUBAN_API_TOKEN=

BANGUMI_API_BASE_URL=https://api.bgm.tv
BANGUMI_ACCESS_TOKEN=
BANGUMI_USER_AGENT=family-app/0.1 (self-hosted household media search)

# Encrypts household integration credentials stored in PostgreSQL.
# Production must use an independently generated 32-byte Base64 or 64-char hex key.
INTEGRATION_SECRET_KEY=
