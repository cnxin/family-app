{$SITE_ADDRESS} {
	# 事件流（SSE）不压缩：encode 要先攒够字节才决定压不压，会把 hello / 心跳 / changed 卡住
	@compressible not path /api/events
	encode @compressible zstd gzip

	# /api/events 是长连接事件流：代理不缓冲，每条立刻发出去（H2）
	handle /api/events {
		uri strip_prefix /api
		reverse_proxy api:3100 {
			flush_interval -1
		}
	}

	handle_path /api/* {
		reverse_proxy api:3100
	}

	handle /uploads/* {
		reverse_proxy api:3100
	}

	# 旧客户端已在 H1 删除。家里人的书签和旧端发出的访客链接（/legacy/guest/<token>）
	# 跳到去掉前缀的同名新路径，查询串保留。要放在默认 handle 之前，不然会被它先吃掉。
	redir /legacy / 302
	handle_path /legacy/* {
		redir * {uri} 302
	}

	# 构建产物都在 /assets 下且文件名带内容哈希：内容一变名字就变，可以让浏览器缓存一年并视为不可变；
	# 发版后旧分块不存在时直接 404（不回退到 index.html），前端的懒加载失败刷新逻辑靠它判断。
	handle /assets/* {
		root * /srv
		@asset file
		header @asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html 名字不变、内容随发版变：每次都回源校验（ETag），保证拿到的是最新一版的分块清单。
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		-Server
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' data:; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; manifest-src 'self'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}

:2015 {
	respond /healthz "ok" 200
}
