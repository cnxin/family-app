# Use a DNS hostname for automatic HTTPS. For a LAN-only HTTP rehearsal, use :80.
SITE_ADDRESS=family.example.com
CORS_ORIGINS=https://family.example.com

POSTGRES_USER=family
POSTGRES_DB=family_app
DB_PASSWORD_SECRET_PATH=./deploy/secrets/db_password.txt
JWT_SECRET_PATH=./deploy/secrets/jwt_secret.txt
BOOTSTRAP_SECRET_PATH=./deploy/secrets/bootstrap_secret.txt

APP_VERSION=latest
TZ=Asia/Shanghai
HTTP_PORT=80
HTTPS_PORT=443
TRUST_PROXY_HOPS=1

JWT_EXPIRES_SECONDS=900
REFRESH_TOKEN_EXPIRES_SECONDS=2592000
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_MS=60000

# Optional media connectors. Prefer *_FILE paths under /run/integration-secrets.
MEDIA_PRIMARY_LIBRARY=plex
PLEX_BASE_URL=
PLEX_TOKEN=
PLEX_TOKEN_FILE=
PLEX_NAME=Plex
EMBY_BASE_URL=
EMBY_API_KEY=
EMBY_API_KEY_FILE=
EMBY_NAME=Emby
MOVIEPILOT_BASE_URL=
MOVIEPILOT_API_KEY=
MOVIEPILOT_API_KEY_FILE=
MOVIEPILOT_NAME=MoviePilot

API_CPU_LIMIT=1.00
API_MEMORY_LIMIT=512M
DB_CPU_LIMIT=1.00
DB_MEMORY_LIMIT=1G
WEB_CPU_LIMIT=0.50
WEB_MEMORY_LIMIT=256M
